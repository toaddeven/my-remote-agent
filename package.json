{
  "name": "work-agent",
  "version": "1.0.0",
  "description": "独立 AI Agent，类 OpenClaw，可在公司环境运行",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --skipLibCheck --excludeFiles '**/*.test.ts'",
    "start": "node dist/index.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:fast": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:gateway": "vitest run --config vitest.gateway.config.ts",
    "test:extensions": "vitest run --config vitest.extensions.config.ts",
    "test:all": "npm run build && npm test && npm run test:e2e"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "openai",
    "feishu"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@tobilu/qmd": "^2.0.1",
    "@types/uuid": "^10.0.0",
    "https-proxy-agent": "^7.0.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "node-fetch": "^3.3.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
