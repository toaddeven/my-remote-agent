{
  "feishu": {
    "appId": "${TEST_FEISHU_APP_ID}",
    "appSecret": "${TEST_FEISHU_APP_SECRET}",
    "domain": "feishu",
    "botName": "TestAgent"
  },
  "model": {
    "backend": "api",
    "default": "anthropic/claude-opus-4-6",
    "apiKey": "${TEST_ANTHROPIC_API_KEY}",
    "baseUrl": "https://api.anthropic.com"
  },
  "agents": [
    { "id": "main", "workspace": "./workspace" }
  ],
  "bindings": [
    { "agentId": "main", "match": { "channel": "feishu", "peer": { "kind": "direct" } } }
  ]
}
